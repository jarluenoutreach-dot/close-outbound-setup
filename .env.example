# Copy to .env (install.sh does this) and fill in. .env is in .gitignore — never commit it.

# --- Secrets ---------------------------------------------------------------
# Close: Settings → Developer → API Keys. Create the key while logged in as YOU,
# because texts are sent as the key's owner.
CLOSE_API_KEY=
# From @BotFather (see README → Telegram bot)
TELEGRAM_BOT_TOKEN=
# From `outbound telegram-chat-id`
TELEGRAM_CHAT_ID=
# Filled in automatically by `outbound setup-webhook`
CLOSE_WEBHOOK_SIGNATURE_KEY=
CLOSE_WEBHOOK_ID=

# --- Who / what (defaults shown; uncomment to change) ------------------------
# MY_USER_ID=user_9LGnQqtaen7jdlZ3P10lTbiVcjELWdhZw52QHGCQF2w
# SMART_VIEW_ID=save_qXqdB9NfSbAyAEkNxorj51QmKP1jMEAa9Vo9petBUmU
# SMART_VIEW_NAME=Webinar Workflow
# LOCAL_PHONE=+19786669462
# DEFAULT_TIMEZONE=America/Chicago

# --- Rules -------------------------------------------------------------------
# LOOKBACK_DAYS=60
# Rule 5: skip if another setter texted within this many days
# OTHER_SETTER_TEXT_DAYS=7
# LONG_CALL_SECONDS=120

# --- Sending -----------------------------------------------------------------
# SEND_WINDOW_START_HOUR=8
# SEND_WINDOW_END_HOUR=20
# MIN_SECONDS_BETWEEN_SENDS=15
# MAX_SENDS_PER_HOUR=60
# SCHEDULE_SPACING_SECONDS=15

# --- Test mode ---------------------------------------------------------------
# When set, the service ignores every lead except ones with these phone numbers
# (comma-separated). Use it for the end-to-end test in TESTING.md, then remove it.
# TEST_PHONES=+15551234567

# --- Timing ------------------------------------------------------------------
# WEBHOOK_DELAY_SECONDS=5
# SWEEP_INTERVAL_SECONDS=300
# How often the sweep re-checks a lead that was skipped (it may have become eligible)
# RECHECK_SKIPPED_MINUTES=60
# ERROR_CHECK_DELAY_SECONDS=120
# ERROR_STOP_THRESHOLD=3
# MORNING_CHECK_MINUTES_BEFORE=5
