[Unit]
Description=Close CRM first-text outbound service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{APP_USER}}
Group={{APP_USER}}
WorkingDirectory={{APP_DIR}}
ExecStart={{APP_DIR}}/.venv/bin/python -m outbound serve --host 127.0.0.1 --port {{PORT}}
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening: the service can only write inside the project folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{APP_DIR}}

[Install]
WantedBy=multi-user.target
